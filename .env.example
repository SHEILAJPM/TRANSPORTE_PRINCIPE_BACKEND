# Copiar a .env y completar. Este archivo SÍ va al repositorio: nunca pongas aquí
# valores reales (contraseñas, tokens, rutas de tu computadora).

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://usuario:contrasena@host:5432/transporte_principe
DATABASE_URL_SYNC=postgresql+psycopg2://usuario:contrasena@host:5432/transporte_principe

# --- Seguridad ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# --- apisunat.pe (emisión de comprobantes electrónicos: GRE, factura, boleta, N. crédito) ---
APISUNAT_BASE_URL=https://api.apisunat.pe
APISUNAT_TOKEN=
APISUNAT_TIMEOUT_SECONDS=10

# --- Decolecta (consulta de RUC/DNI vía RENIEC/SUNAT para autocompletar clientes) ---
DECOLECTA_BASE_URL=https://api.decolecta.com
DECOLECTA_TOKEN=
DECOLECTA_TIMEOUT_SECONDS=10

# --- Guía de Remisión Transportista: quién la emite ---
# sunat_directo -> XML UBL 2.1 firmado con el certificado .p12 y enviado a la API REST de GRE
# apisunat      -> vía apisunat.pe (flujo anterior)
GRE_PROVEEDOR=sunat_directo

# --- Certificado digital (.p12) para firmar ---
# El .p12 NUNCA va al repositorio.
#   Local:  ruta a una carpeta de tu computadora fuera del proyecto
#           (p.ej. C:/Users/<usuario>/certificados/certificado.p12)
#   Render: súbelo como Secret File; queda en /etc/secrets/<nombre-del-archivo>.p12
SUNAT_CERT_PATH=
SUNAT_CERT_PASSWORD=

# --- API REST de GRE de SUNAT ---
# SUNAT no tiene entorno beta para GRE: todo envío es real (por eso el sistema
# exige confirmar una vista previa antes de enviar).
SUNAT_GRE_TOKEN_URL=https://api-seguridad.sunat.gob.pe/v1/clientessol
SUNAT_GRE_API_URL=https://api-cpe.sunat.gob.pe/v1
# Credenciales "API SUNAT" generadas en SUNAT Operaciones en Línea (menú Credenciales de API)
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=
# Usuario SOL secundario: RUC + usuario, p.ej. 20123456789USUARIO
SUNAT_SOL_USUARIO=
SUNAT_SOL_CLAVE=
SUNAT_GRE_TIMEOUT_SECONDS=20

# --- Almacenamiento de archivos (logo, comprobantes, fotos) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# XML firmados y CDR de SUNAT (privados, no se sirven en /static)
STORAGE_PRIVADO_LOCAL_PATH=./storage_privado
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Celery / Redis (alertas de vencimiento SOAT, CITV, licencias) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Alertas de vencimiento (días de anticipación) ---
ALERTA_DIAS_ANTICIPACION_SOAT=30
ALERTA_DIAS_ANTICIPACION_CITV=30
ALERTA_DIAS_ANTICIPACION_MTC=30
ALERTA_DIAS_ANTICIPACION_LICENCIA=30

ENVIRONMENT=development
